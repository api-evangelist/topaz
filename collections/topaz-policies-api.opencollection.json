{
  "opencollection": "1.0.0",
  "info": {
    "name": "Topaz and Directory Authorizer Policies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List loaded policy modules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8383/api/v2/policies"
          },
          "docs": "Lists the OPA policy modules currently loaded into the authorizer."
        },
        {
          "info": {
            "name": "Get a policy module",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8383/api/v2/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a single loaded OPA policy module by id."
        }
      ]
    }
  ],
  "bundled": true
}